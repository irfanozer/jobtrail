# The start script creates .env with random passwords when .env does not exist.
# For manual setup, copy this file to .env and fill in the passwords.
# Keep the database password unchanged after the database volume is created.
DATABASE_USERNAME=jobtrail
DATABASE_PASSWORD=

# Local containers are reachable only through 127.0.0.1:8080.
# Enable sign-in with true and a password of at least 16 characters.
# The hosted deployment profile always requires sign-in.
JOBTRAIL_AUTH_ENABLED=false
JOBTRAIL_USERNAME=owner
JOBTRAIL_PASSWORD=

# Blank uses the local Compose database. The restore script can set a recovery database.
JDBC_DATABASE_URL=

JOBTRAIL_REFRESH_ON_STARTUP=false
JOBTRAIL_SCHEDULED_REFRESH=false
